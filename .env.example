# Your DealPOS tenant host (no protocol). Optional: the built-in default is the original
# author's tenant, so set this to your own.
DEALPOS_SUBDOMAIN=yourshop.dealpos.co.id
# OAuth2 client credentials (GUIDs) issued in DealPOS Setup/Settings. Required.
DEALPOS_CLIENT_ID=
DEALPOS_CLIENT_SECRET=
# Defaults
DEALPOS_DEFAULT_OUTLET=Main Store
DEALPOS_LOW_STOCK_FALLBACK=5
# Read-only by default. Set to false to let the 10 write tools run.
DEALPOS_READ_ONLY=true
